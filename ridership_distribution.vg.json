{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Distribution of Daily Public Transport Ridership",
    "subtitle": "Count of days of different daily ridership volumes(2022–2026)",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666"
  },
  "width": 700,
  "height": 350,
  "data": {
    "url": "daily_total.csv"
  },
  "mark": {
    "type": "bar",
    "color": "#6fa351",
    "opacity": 0.8
  },
  "encoding": {
    "x": {
      "field": "total",
      "type": "quantitative",
      "bin": {"maxbins": 30},
      "title": "Daily total trips",
      "axis": {"format": "~s"}
    },
    "y": {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Number of days at this ridership level"
    },
    "tooltip": [
      {"field": "total", "type": "quantitative", "bin": {"maxbins": 30}, "title": "Daily trips range"},
      {"aggregate": "count", "type": "quantitative", "title": "Days"}
    ]
  }
}