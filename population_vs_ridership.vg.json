{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Population vs Public Transport Ridership by State (2025)",
    "subtitle": "Klang Valley breaks the pattern that ties to all other states",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666"
  },
  "width": 700,
  "height": 400,
  "data": {
    "url": "ridership_by_state_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 200,
        "opacity": 0.7,
        "color": "#0011fc"
      },
      "encoding": {
        "x": {
          "field": "population",
          "type": "quantitative",
          "title": "Population (thousands)",
          "scale": {"type": "log"},
          "axis": {"format": ","}
        },
        "y": {
          "field": "daily_ridership",
          "type": "quantitative",
          "title": "Average daily public transport trips",
          "scale": {"type": "log", "domainMin": 1},
          "axis": {"format": ","}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "population", "type": "quantitative", "title": "Population (thousands)", "format": ","},
          {"field": "daily_ridership", "type": "quantitative", "title": "Daily ridership", "format": ","},
          {"field": "trips_per_1000", "type": "quantitative", "title": "Trips per 1,000", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 10,
        "color": "#333"
      },
      "encoding": {
        "x": {"field": "population", "type": "quantitative", "scale": {"type": "log"}},
        "y": {"field": "daily_ridership", "type": "quantitative", "scale": {"type": "log", "domainMin": 1}},
        "text": {"field": "state", "type": "nominal"}
      }
    }
  ],
  "transform": [
    {"filter": "datum.daily_ridership > 0"}
  ]
}